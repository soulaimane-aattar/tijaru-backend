{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/enforce-make-targets.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx eslint *)",
      "Bash(docker cp *)",
      "Bash(docker exec *)",
      "Bash(docker compose exec * psql *)",
      "Bash(npx tsc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(find *)",
      "Bash(ls *)"
    ]
  }
}
