NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://stock:stock@localhost:5432/stock?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-xxxxx
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-xxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12
RATE_LIMIT_LOGIN_PER_MIN=5
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
LOG_LEVEL=info
PLATFORM_ADMIN_EMAIL=admin@platform.local
PLATFORM_ADMIN_PASSWORD=changeme123

# Outgoing email (leave SMTP_HOST empty to disable — sends become no-ops)
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465); false = STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Tijaru <no-reply@tijaru.com>
APP_URL=https://tijaru.com
