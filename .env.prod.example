# Tijaru - production env for docker-compose.prod.yml
# Copy to .env.prod and fill in. NEVER commit the real .env.prod.
#   cp .env.prod.example .env.prod

# Database (internal only, no host port)
POSTGRES_USER=tijaru
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=tijaru

# DATABASE_URL is read directly by the backend (env_file). Host = the compose
# service name `postgres`, port 5432 (internal). Keep user/pass/db in sync above.
DATABASE_URL=postgresql://tijaru:change-me-strong-db-password@postgres:5432/tijaru?schema=public

# OCR service (internal only, no host port). `fr` = single pass.
# `fr,ar` adds an Arabic pass and roughly doubles latency.
OCR_LANGS=fr

# External nginx-proxy wiring (defaults match ../euras/eurasians-proxy)
NGINX_PROXY_NETWORK=nginx-proxy
NGINX_API_UPSTREAM=tijaru-backend

# CORS: comma-separated origins, NO trailing slash.
# Must include the Cloudflare Pages web origin(s).
CORS_ORIGINS=https://www.tijaru.ma,https://tijaru.pages.dev

# JWT (min 32 chars each). Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Security tuning
BCRYPT_COST=12
LOG_LEVEL=info

# First platform admin (used by app)
PLATFORM_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
PLATFORM_ADMIN_PASSWORD=change-me-strong-admin-password
