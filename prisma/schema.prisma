// Stock — Prisma schema. Mirrors Stock-build-spec.md §5.1.
// Single-tenant deployment (one Business per database).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────

enum SubscriptionPlan {
  trial
  active
  expired
  suspended
}

enum BusinessStatus {
  active
  suspended
  pending
  rejected
}

model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("platform_admins")
}

/// Journal of super-admin console actions (extend, suspend, approve…). Append-only.
model PlatformAuditLog {
  id         String   @id @default(cuid())
  action     String
  tone       String   @default("ok")
  targetType String   @default("business") @map("target_type")
  targetId   String?  @map("target_id")
  targetName String   @map("target_name")
  detail     String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("platform_audit_logs")
}

model Business {
  id                String           @id @default(cuid())
  name              String
  ice               String?          @unique
  rc                String?
  patente           String?
  ifNum             String?          @map("if_num")
  cnss              String?
  address           String?
  city              String?
  phone             String?
  logo              String?
  status            BusinessStatus   @default(active)
  plan              SubscriptionPlan @default(trial)
  subscriptionStart DateTime?        @map("subscription_start")
  subscriptionEnd   DateTime?        @map("subscription_end")
  maxUsers          Int              @default(5) @map("max_users")
  maxProducts       Int              @default(100) @map("max_products")
  maxWarehouses     Int              @default(2) @map("max_warehouses")
  multiWarehouse    Boolean          @default(true) @map("multi_warehouse")
  enabledVatRates   Int[]            @default([0, 7, 10, 14, 20]) @map("enabled_vat_rates")
  /// When false, signing bons no longer moves stock (documentary signatures only).
  bonsAffectStock   Boolean          @default(true) @map("bons_affect_stock")
  createdBy         String?          @map("created_by")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  securityPolicy SecurityPolicy?

  warehouses         Warehouse[]
  users              User[]
  customRoles        CustomRole[]
  roleCustomizations RoleCustomization[]
  categories         Category[]
  suppliers          Supplier[]
  customers          Customer[]
  products           Product[]
  stockLevels        StockLevel[]
  movements          Movement[]
  purchaseOrders     PurchaseOrder[]
  poSessions         POSession[]
  poTickets          POTicket[]
  inventoryCounts    InventoryCount[]
  notifications      Notification[]
  activities         Activity[]
  modules            BusinessModule[]
  expenses           Expense[]
  invoices           Invoice[]
  deliveryNotes      DeliveryNote[]
  expenseCategoryDefs ExpenseCategoryDef[]

  @@map("businesses")
}

// ─── Warehouses ──────────────────────────────────────────────────────────────

model Warehouse {
  id         String    @id @default(cuid())
  businessId String    @map("business_id")
  name       String
  city       String
  address    String?
  phone      String?
  active     Boolean   @default(true)
  isDefault  Boolean   @default(false)
  managerId  String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  manager         User?            @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  stockLevels     StockLevel[]
  movements       Movement[]       @relation("WarehouseMovements")
  transfersIn     Movement[]       @relation("WarehouseTransfersIn")
  users           UserWarehouse[]
  purchaseOrders  PurchaseOrder[]
  inventoryCounts InventoryCount[]
  expenses        Expense[]

  @@index([businessId])
  @@map("warehouses")
}

// ─── Users + Roles + Permissions ─────────────────────────────────────────────

enum BuiltInRole {
  owner
  admin
  manager
  stockkeeper
  cashier
  viewer
}

model User {
  id           String      @id @default(cuid())
  businessId   String      @map("business_id")
  name         String
  email        String      @unique
  phone        String?
  passwordHash String
  role         BuiltInRole
  tokenVersion Int         @default(0)
  active       Boolean     @default(true)
  lastLogin    DateTime?
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouses        UserWarehouse[]
  managedWarehouses Warehouse[]     @relation("WarehouseManager")
  overrides         UserOverride[]
  movements         Movement[]
  sessions          Session[]
  activities        Activity[]
  posTickets        POTicket[]
  expenses          Expense[]
  invoicesIssued    Invoice[]              @relation("InvoiceIssuer")
  deliveryNotes     DeliveryNote[]         @relation("DeliveryNoteIssuer")
  bonPayments       DeliveryNotePayment[]  @relation("PaymentCreator")

  @@index([businessId])
  @@map("users")
}

model UserWarehouse {
  userId      String
  warehouseId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@map("user_warehouses")
}

model UserOverride {
  userId  String
  capId   String
  granted Boolean

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, capId])
  @@map("user_overrides")
}

model CustomRole {
  id         String       @id @default(cuid())
  businessId String       @map("business_id")
  name       String
  tone       String
  inherits   BuiltInRole?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  capabilities RoleCapability[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("custom_roles")
}

model RoleCapability {
  customRoleId String
  capId        String
  granted      Boolean

  customRole CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)

  @@id([customRoleId, capId])
  @@map("role_capabilities")
}

/// Per-cap override on a built-in role. Spec §7.14 — owner is locked (UI-enforced),
/// other built-in roles may have caps toggled. Stored as diffs against the canonical
/// ROLE_PERMS matrix in src/domain/permissions.ts.
model RoleCustomization {
  businessId String      @map("business_id")
  role       BuiltInRole
  capId      String
  granted    Boolean

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, role, capId])
  @@map("role_customizations")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  device           String?
  os               String?
  ip               String?
  city             String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model SecurityPolicy {
  id                   String   @id @default(cuid())
  businessId           String   @unique
  passwordMinLen       Int      @default(8)
  requireUpper         Boolean  @default(true)
  requireDigit         Boolean  @default(true)
  requireSymbol        Boolean  @default(false)
  passwordExpiryDays   Int      @default(0)
  passwordHistoryCount Int      @default(0)
  twoFARequiredFor     String[] @default([])
  lockAfterFailures    Int      @default(5)
  sessionTimeoutMin    Int      @default(60)
  ipAllowlist          String[] @default([])
  auditRetentionDays   Int      @default(365)
  updatedAt            DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("security_policies")
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Category {
  id         String  @id @default(cuid())
  businessId String  @map("business_id")
  name       String
  icon       String
  tone       String
  active     Boolean @default(true)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("categories")
}

model Supplier {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  name       String
  contact    String?
  phone      String?
  city       String?
  ice        String?
  email      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products       Product[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]
  deliveryNotes  DeliveryNote[]

  @@index([businessId])
  @@map("suppliers")
}

model Customer {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  name        String
  phone       String?
  city        String?
  ice         String?
  purchases   Decimal  @default(0) @db.Decimal(14, 2)
  /// Credit ceiling for this customer (dette alert threshold). NULL = no limit.
  creditLimit Decimal? @map("credit_limit") @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tickets       POTicket[]
  invoices      Invoice[]
  deliveryNotes DeliveryNote[]

  @@index([businessId])
  @@map("customers")
}

enum Unit {
  piece
  kg
  g
  litre
  ml
  carton
  pack
}

model Product {
  id          String    @id @default(cuid())
  businessId  String    @map("business_id")
  name        String
  barcode     String
  sku         String
  categoryId  String
  purchase    Decimal   @db.Decimal(12, 2) // HT
  sale        Decimal   @db.Decimal(12, 2) // HT
  vat         Int // 0|7|10|14|20
  unit        Unit      @default(piece)
  supplierId  String?
  trackExpiry Boolean   @default(false)
  expiry      DateTime?
  batch       String?
  minStock    Int       @default(0)
  maxStock    Int       @default(0)
  notes       String?
  tone        String    @default("#94a3b8")
  imagePath   String?   @map("image_path")
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category       Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier       Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockLevels    StockLevel[]
  movements      Movement[]
  poLines        PurchaseOrderLine[]
  ticketLines    POTicketLine[]
  invoiceLines   InvoiceLine[]
  deliveryLines  DeliveryNoteLine[]
  inventoryLines InventoryCountLine[]

  @@unique([businessId, barcode])
  @@unique([businessId, sku])
  @@index([businessId])
  @@index([categoryId])
  @@index([supplierId])
  @@map("products")
}

model StockLevel {
  productId   String
  warehouseId String
  businessId  String
  qty         Int      @default(0)
  reservedQty Int      @default(0)
  avgCost     Decimal  @default(0) @db.Decimal(12, 4)
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([productId, warehouseId])
  @@index([businessId, productId])
  @@index([warehouseId])
  @@map("stock_levels")
}

// ─── Movements ───────────────────────────────────────────────────────────────

enum MovementType {
  in
  out
  transfer
}

enum MovementReason {
  achat
  vente
  transfert
  peremption
  ajustement
  casse
  retour
}

model Movement {
  id            String         @id @default(cuid())
  businessId    String         @map("business_id")
  type          MovementType
  productId     String
  qty           Int
  warehouseId   String
  toWarehouseId String?
  userId        String
  date          DateTime       @default(now())
  reason        MovementReason
  ref           String?
  batch         String?
  expiry        DateTime?
  createdAt     DateTime       @default(now())

  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse  @relation("WarehouseMovements", fields: [warehouseId], references: [id], onDelete: Restrict)
  toWarehouse Warehouse? @relation("WarehouseTransfersIn", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  user        User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([productId])
  @@index([warehouseId])
  @@index([date])
  @@map("movements")
}

// ─── Purchase Orders ─────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  draft
  sent
  partiallyReceived
  received
  cancelled
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  businessId  String              @map("business_id")
  number      String // "BC-YYYY-####"
  supplierId  String
  warehouseId String
  status      PurchaseOrderStatus @default(draft)
  date        DateTime            @default(now())
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines     PurchaseOrderLine[]

  @@unique([businessId, number])
  @@index([businessId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String
  qty             Int
  price           Decimal @db.Decimal(12, 2)
  vat             Int
  received        Int     @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

// ─── POS ─────────────────────────────────────────────────────────────────────

model POSession {
  id           String    @id // "S-YYYYMMDD"
  businessId   String    @map("business_id")
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  openingFloat Decimal   @default(0) @db.Decimal(12, 2)
  sales        Int       @default(0)
  revenue      Decimal   @default(0) @db.Decimal(14, 2)

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tickets  POTicket[]

  @@index([businessId])
  @@map("po_sessions")
}

enum PaymentMethod {
  cash
  card
  credit
  split
}

model POTicket {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  number      String // "TKT-####"
  date        DateTime @default(now())
  cashierId   String
  warehouseId String
  customerId  String?
  sessionId   String
  ht          Decimal  @db.Decimal(14, 2)
  tva         Decimal  @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)
  discount    Decimal  @default(0) @db.Decimal(14, 2)
  due         Decimal  @default(0) @db.Decimal(14, 2)
  payment     Json
  parked      Boolean  @default(false)
  createdAt   DateTime @default(now())

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cashier  User           @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  customer Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  session  POSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  lines    POTicketLine[]

  @@unique([businessId, number])
  @@index([businessId])
  @@index([sessionId])
  @@index([cashierId])
  @@index([date])
  @@map("po_tickets")
}

model POTicketLine {
  id        String  @id @default(cuid())
  ticketId  String
  productId String
  qty       Int
  priceTtc  Decimal @db.Decimal(12, 2)
  vat       Int

  ticket  POTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("po_ticket_lines")
}

// ─── Inventory counts ────────────────────────────────────────────────────────

model InventoryCount {
  id          String    @id @default(cuid())
  businessId  String    @map("business_id")
  warehouseId String
  date        DateTime  @default(now())
  appliedAt   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  business  Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouse Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines     InventoryCountLine[]

  @@index([businessId])
  @@map("inventory_counts")
}

model InventoryCountLine {
  id        String @id @default(cuid())
  countId   String
  productId String
  expected  Int
  counted   Int

  count   InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([countId])
  @@map("inventory_count_lines")
}

// ─── Notifications + Activity ────────────────────────────────────────────────

enum NotificationType {
  lowStock
  expiring
  userInvited
  poReceived
  variance
  outOfStock
}

model Notification {
  id         String           @id @default(cuid())
  businessId String           @map("business_id")
  type       NotificationType
  title      String
  body       String
  date       DateTime         @default(now())
  read       Boolean          @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([date])
  @@map("notifications")
}

model Activity {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  userId     String?
  action     String
  desc       String
  date       DateTime @default(now())
  device     String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([date])
  @@index([userId])
  @@map("activities")
}

// ─── Business modules (feature gating) ───────────────────────────────────────

model BusinessModule {
  businessId String   @map("business_id")
  moduleId   String   @map("module_id")
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, moduleId])
  @@map("business_modules")
}

// ─── Expenses (dépenses) ─────────────────────────────────────────────────────

/// Per-tenant configurable expense category. The `key` is the stable slug
/// stored on `Expense.category`; `label` and `taxRate` can be edited without
/// migrating historical rows.
model ExpenseCategoryDef {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  key        String
  label      String
  taxRate    Decimal  @default(20.00) @map("tax_rate") @db.Decimal(5, 2)
  sortOrder  Int      @default(0) @map("sort_order")
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@index([businessId, archived, sortOrder])
  @@map("expense_category_defs")
}

enum OcrStatus {
  pending
  done
  failed
}

/// A recorded business expense. `receiptPath` points at an image on the API's
/// own filesystem; `ocrRaw` keeps the OCR blocks so a bad extraction can be
/// re-parsed offline without re-running the engine.
model Expense {
  id            String          @id @default(cuid())
  businessId    String          @map("business_id")
  warehouseId   String?         @map("warehouse_id")
  date          DateTime
  amount        Decimal         @db.Decimal(12, 2)
  taxAmount     Decimal?        @map("tax_amount") @db.Decimal(12, 2)
  category      String          @default("other")
  supplierId    String?         @map("supplier_id")
  merchantName  String?         @map("merchant_name")
  note          String?
  paymentMethod PaymentMethod   @default(cash) @map("payment_method")
  receiptPath   String?         @map("receipt_path")
  receiptHash   String?         @map("receipt_hash") @db.Char(64)
  ocrStatus     OcrStatus?      @map("ocr_status")
  ocrRaw        Json?           @map("ocr_raw")
  createdById   String          @map("created_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  supplier  Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy User       @relation(fields: [createdById], references: [id])

  @@index([businessId, date])
  @@index([businessId, category])
  @@index([businessId, receiptHash])
  @@map("expenses")
}

// ─── Invoices (customer billing — B2B) ───────────────────────────────────────

enum InvoiceStatus {
  draft
  sent
  partial
  paid
  overdue
  cancelled
}

model Invoice {
  id         String        @id @default(cuid())
  businessId String        @map("business_id")
  number     String // "FA-YYYY-NNNN"
  date       DateTime      @default(now())
  dueDate    DateTime      @map("due_date")
  customerId String        @map("customer_id")
  issuedById String        @map("issued_by_id")
  status     InvoiceStatus @default(draft)
  ht         Decimal       @db.Decimal(14, 2)
  tva        Decimal       @db.Decimal(14, 2)
  discount   Decimal       @default(0) @db.Decimal(14, 2)
  total      Decimal       @db.Decimal(14, 2)
  paid       Decimal       @default(0) @db.Decimal(14, 2)
  notes      String?
  terms      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issuedBy User          @relation("InvoiceIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  lines    InvoiceLine[]

  @@unique([businessId, number])
  @@index([businessId, date])
  @@index([businessId, status])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String  @map("invoice_id")
  productId String  @map("product_id")
  label     String
  qty       Decimal @db.Decimal(12, 3)
  priceHt   Decimal @map("price_ht") @db.Decimal(12, 2)
  vat       Int
  discount  Decimal @default(0) @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("invoice_lines")
}

// ─── Delivery notes / Purchase notes (BC · BL · BR) ──────────────────────────

enum DeliveryNoteType {
  order // BC — bon de commande (vers fournisseur)
  out // BL — bon de livraison (vers client)
  in_ // BR — bon de réception (du fournisseur)  (`in` is a reserved SQL keyword)
  retour // RT — retour client (annule tout ou partie d'une BL)
}

enum DeliveryNoteStatus {
  prepared
  sent
  shipped
  partial
  delivered
  closed
}

enum BonPaymentMethod {
  cash
  card
  transfer
  other
}

model DeliveryNote {
  id         String             @id @default(cuid())
  businessId String             @map("business_id")
  number     String // "BC-YYYY-NNNN" | "BL-YYYY-NNNN" | "BR-YYYY-NNNN"
  type       DeliveryNoteType
  date       DateTime           @default(now())
  status     DeliveryNoteStatus @default(prepared)
  customerId String?            @map("customer_id")
  supplierId String?            @map("supplier_id")
  issuedById String             @map("issued_by_id")
  sourceRef  String?            @map("source_ref") // e.g. DV-XXXX, FA-XXXX, BC-XXXX
  carrier    String?
  signed     Boolean            @default(false)
  signedAt   DateTime?          @map("signed_at")
  notes      String?
  paid       Decimal            @default(0) @db.Decimal(14, 2)
  returnOfId String?            @map("return_of_id")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  business Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  issuedBy User                 @relation("DeliveryNoteIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  returnOf DeliveryNote?        @relation("BonReturns", fields: [returnOfId], references: [id], onDelete: SetNull)
  returns  DeliveryNote[]       @relation("BonReturns")
  payments DeliveryNotePayment[]
  lines    DeliveryNoteLine[]

  @@unique([businessId, number])
  @@index([businessId, date])
  @@index([businessId, type])
  @@index([businessId, status])
  @@index([customerId])
  @@index([returnOfId])
  @@map("delivery_notes")
}

model DeliveryNotePayment {
  id             String        @id @default(cuid())
  businessId     String        @map("business_id")
  deliveryNoteId String        @map("delivery_note_id")
  amount         Decimal       @db.Decimal(14, 2)
  method         BonPaymentMethod @default(cash)
  note           String?
  createdById    String        @map("created_by_id")
  createdAt      DateTime      @default(now())

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([deliveryNoteId])
  @@index([businessId, createdAt])
  @@map("delivery_note_payments")
}

model DeliveryNoteLine {
  id             String  @id @default(cuid())
  deliveryNoteId String  @map("delivery_note_id")
  productId      String  @map("product_id")
  label          String
  ordered        Decimal @db.Decimal(12, 3)
  sent           Decimal @default(0) @db.Decimal(12, 3)
  unitPrice      Decimal @default(0) @db.Decimal(12, 2) @map("unit_price")

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([deliveryNoteId])
  @@map("delivery_note_lines")
}
