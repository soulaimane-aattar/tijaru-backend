// Stock — Prisma schema. Mirrors Stock-build-spec.md §5.1.
// Single-tenant deployment (one Business per database).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────

enum BusinessStatus {
  active
  suspended
}

model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("platform_admins")
}

model Business {
  id        String         @id @default(cuid())
  name      String
  ice       String         @unique
  rc        String?
  patente   String?
  ifNum     String?        @map("if_num")
  cnss      String?
  address   String?
  city      String?
  phone     String?
  logo      String?
  status    BusinessStatus @default(active)
  createdBy String?        @map("created_by")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  securityPolicy SecurityPolicy?

  warehouses         Warehouse[]
  users              User[]
  customRoles        CustomRole[]
  roleCustomizations RoleCustomization[]
  categories         Category[]
  suppliers          Supplier[]
  customers          Customer[]
  products           Product[]
  movements          Movement[]
  purchaseOrders     PurchaseOrder[]
  poSessions         POSession[]
  poTickets          POTicket[]
  inventoryCounts    InventoryCount[]
  notifications      Notification[]
  activities         Activity[]
  modules            BusinessModule[]
  expenses           Expense[]

  @@map("businesses")
}

// ─── Warehouses ──────────────────────────────────────────────────────────────

model Warehouse {
  id        String    @id @default(cuid())
  businessId String   @map("business_id")
  name      String
  city      String
  address   String?
  phone     String?
  active    Boolean   @default(true)
  isDefault Boolean   @default(false)
  managerId String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  manager     User?         @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  stockLevels StockLevel[]
  movements   Movement[]    @relation("WarehouseMovements")
  transfersIn Movement[]    @relation("WarehouseTransfersIn")
  users       UserWarehouse[]
  purchaseOrders PurchaseOrder[]
  inventoryCounts InventoryCount[]
  expenses    Expense[]

  @@index([businessId])
  @@map("warehouses")
}

// ─── Users + Roles + Permissions ─────────────────────────────────────────────

enum BuiltInRole {
  owner
  admin
  manager
  stockkeeper
  cashier
  viewer
}

model User {
  id           String      @id @default(cuid())
  businessId   String      @map("business_id")
  name         String
  email        String      @unique
  phone        String?
  passwordHash String
  role         BuiltInRole
  tokenVersion Int         @default(0)
  active       Boolean     @default(true)
  lastLogin    DateTime?
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouses        UserWarehouse[]
  managedWarehouses Warehouse[]     @relation("WarehouseManager")
  overrides         UserOverride[]
  movements         Movement[]
  sessions          Session[]
  activities        Activity[]
  posTickets        POTicket[]
  expenses          Expense[]

  @@index([businessId])
  @@map("users")
}

model UserWarehouse {
  userId      String
  warehouseId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@map("user_warehouses")
}

model UserOverride {
  userId   String
  capId    String
  granted  Boolean

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, capId])
  @@map("user_overrides")
}

model CustomRole {
  id        String   @id @default(cuid())
  businessId String  @map("business_id")
  name      String
  tone      String
  inherits  BuiltInRole?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  capabilities RoleCapability[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("custom_roles")
}

model RoleCapability {
  customRoleId String
  capId        String
  granted      Boolean

  customRole CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)

  @@id([customRoleId, capId])
  @@map("role_capabilities")
}

/// Per-cap override on a built-in role. Spec §7.14 — owner is locked (UI-enforced),
/// other built-in roles may have caps toggled. Stored as diffs against the canonical
/// ROLE_PERMS matrix in src/domain/permissions.ts.
model RoleCustomization {
  businessId String      @map("business_id")
  role       BuiltInRole
  capId      String
  granted    Boolean

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, role, capId])
  @@map("role_customizations")
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  device           String?
  os               String?
  ip               String?
  city             String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model SecurityPolicy {
  id                   String   @id @default(cuid())
  businessId           String   @unique
  passwordMinLen       Int      @default(8)
  requireUpper         Boolean  @default(true)
  requireDigit         Boolean  @default(true)
  requireSymbol        Boolean  @default(false)
  passwordExpiryDays   Int      @default(0)
  passwordHistoryCount Int      @default(0)
  twoFARequiredFor     String[] @default([])
  lockAfterFailures    Int      @default(5)
  sessionTimeoutMin    Int      @default(60)
  ipAllowlist          String[] @default([])
  auditRetentionDays   Int      @default(365)
  updatedAt            DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("security_policies")
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Category {
  id    String @id @default(cuid())
  businessId String @map("business_id")
  name  String
  icon  String
  tone  String

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("categories")
}

model Supplier {
  id      String  @id @default(cuid())
  businessId String @map("business_id")
  name    String
  contact String?
  phone   String?
  city    String?
  ice     String?
  email   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products       Product[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]

  @@index([businessId])
  @@map("suppliers")
}

model Customer {
  id        String  @id @default(cuid())
  businessId String @map("business_id")
  name      String
  phone     String?
  city      String?
  ice       String?
  purchases Decimal @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tickets  POTicket[]

  @@index([businessId])
  @@map("customers")
}

enum Unit {
  piece
  kg
  g
  litre
  ml
  carton
  pack
}

model Product {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  name        String
  barcode     String
  sku         String
  categoryId  String
  purchase    Decimal  @db.Decimal(12, 2) // HT
  sale        Decimal  @db.Decimal(12, 2) // HT
  vat         Int      // 0|7|10|14|20
  unit        Unit     @default(piece)
  supplierId  String?
  trackExpiry Boolean  @default(false)
  expiry      DateTime?
  batch       String?
  minStock    Int      @default(0)
  maxStock    Int      @default(0)
  notes       String?
  tone        String   @default("#94a3b8")
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier    Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockLevels StockLevel[]
  movements   Movement[]
  poLines     PurchaseOrderLine[]
  ticketLines POTicketLine[]
  inventoryLines InventoryCountLine[]

  @@unique([businessId, barcode])
  @@unique([businessId, sku])
  @@index([businessId])
  @@index([categoryId])
  @@index([supplierId])
  @@map("products")
}

model StockLevel {
  productId   String
  warehouseId String
  qty         Int    @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([productId, warehouseId])
  @@index([warehouseId])
  @@map("stock_levels")
}

// ─── Movements ───────────────────────────────────────────────────────────────

enum MovementType {
  in
  out
  transfer
}

enum MovementReason {
  achat
  vente
  transfert
  peremption
  ajustement
  casse
}

model Movement {
  id            String         @id @default(cuid())
  businessId    String         @map("business_id")
  type          MovementType
  productId     String
  qty           Int
  warehouseId   String
  toWarehouseId String?
  userId        String
  date          DateTime       @default(now())
  reason        MovementReason
  ref           String?
  batch         String?
  expiry        DateTime?
  createdAt     DateTime       @default(now())

  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product       Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse     Warehouse  @relation("WarehouseMovements", fields: [warehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse? @relation("WarehouseTransfersIn", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  user          User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([productId])
  @@index([warehouseId])
  @@index([date])
  @@map("movements")
}

// ─── Purchase Orders ─────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  draft
  sent
  partiallyReceived
  received
  cancelled
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  businessId  String              @map("business_id")
  number      String              // "BC-YYYY-####"
  supplierId  String
  warehouseId String
  status      PurchaseOrderStatus @default(draft)
  date        DateTime            @default(now())
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines     PurchaseOrderLine[]

  @@unique([businessId, number])
  @@index([businessId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String
  qty             Int
  price           Decimal @db.Decimal(12, 2)
  vat             Int
  received        Int     @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

// ─── POS ─────────────────────────────────────────────────────────────────────

model POSession {
  id            String   @id // "S-YYYYMMDD"
  businessId    String   @map("business_id")
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  openingFloat  Decimal  @default(0) @db.Decimal(12, 2)
  sales         Int      @default(0)
  revenue       Decimal  @default(0) @db.Decimal(14, 2)

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tickets  POTicket[]

  @@index([businessId])
  @@map("po_sessions")
}

enum PaymentMethod {
  cash
  card
  credit
  split
}

model POTicket {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  number      String   // "TKT-####"
  date        DateTime @default(now())
  cashierId   String
  warehouseId String
  customerId  String?
  sessionId   String
  ht          Decimal  @db.Decimal(14, 2)
  tva         Decimal  @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)
  discount    Decimal  @default(0) @db.Decimal(14, 2)
  due         Decimal  @default(0) @db.Decimal(14, 2)
  payment     Json
  parked      Boolean  @default(false)
  createdAt   DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cashier  User      @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  session  POSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  lines    POTicketLine[]

  @@unique([businessId, number])
  @@index([businessId])
  @@index([sessionId])
  @@index([cashierId])
  @@index([date])
  @@map("po_tickets")
}

model POTicketLine {
  id        String  @id @default(cuid())
  ticketId  String
  productId String
  qty       Int
  priceTtc  Decimal @db.Decimal(12, 2)
  vat       Int

  ticket  POTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("po_ticket_lines")
}

// ─── Inventory counts ────────────────────────────────────────────────────────

model InventoryCount {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  warehouseId String
  date        DateTime @default(now())
  appliedAt   DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  business  Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouse Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines     InventoryCountLine[]

  @@index([businessId])
  @@map("inventory_counts")
}

model InventoryCountLine {
  id        String @id @default(cuid())
  countId   String
  productId String
  expected  Int
  counted   Int

  count   InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([countId])
  @@map("inventory_count_lines")
}

// ─── Notifications + Activity ────────────────────────────────────────────────

enum NotificationType {
  lowStock
  expiring
  userInvited
  poReceived
  variance
  outOfStock
}

model Notification {
  id    String           @id @default(cuid())
  businessId String       @map("business_id")
  type  NotificationType
  title String
  body  String
  date  DateTime         @default(now())
  read  Boolean          @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([date])
  @@map("notifications")
}

model Activity {
  id     String   @id @default(cuid())
  businessId String @map("business_id")
  userId String?
  action String
  desc   String
  date   DateTime @default(now())
  device String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([date])
  @@index([userId])
  @@map("activities")
}

// ─── Business modules (feature gating) ───────────────────────────────────────

model BusinessModule {
  businessId String   @map("business_id")
  moduleId   String   @map("module_id")
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, moduleId])
  @@map("business_modules")
}

// ─── Expenses (dépenses) ─────────────────────────────────────────────────────

enum ExpenseCategory {
  rent
  utilities
  salaries
  supplies
  transport
  maintenance
  taxes
  marketing
  other
}

enum OcrStatus {
  pending
  done
  failed
}

/// A recorded business expense. `receiptPath` points at an image on the API's
/// own filesystem; `ocrRaw` keeps the OCR blocks so a bad extraction can be
/// re-parsed offline without re-running the engine.
model Expense {
  id            String          @id @default(cuid())
  businessId    String          @map("business_id")
  warehouseId   String?         @map("warehouse_id")
  date          DateTime
  amount        Decimal         @db.Decimal(12, 2)
  taxAmount     Decimal?        @map("tax_amount") @db.Decimal(12, 2)
  category      ExpenseCategory @default(other)
  supplierId    String?         @map("supplier_id")
  merchantName  String?         @map("merchant_name")
  note          String?
  paymentMethod PaymentMethod   @default(cash) @map("payment_method")
  receiptPath   String?         @map("receipt_path")
  ocrStatus     OcrStatus?      @map("ocr_status")
  ocrRaw        Json?           @map("ocr_raw")
  createdById   String          @map("created_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  supplier  Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy User       @relation(fields: [createdById], references: [id])

  @@index([businessId, date])
  @@index([businessId, category])
  @@map("expenses")
}
